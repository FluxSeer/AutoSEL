(handleunknown allow)
(mls true)

(category c0)
(categoryorder (c0))
(sensitivity s0)
(sensitivityorder (s0))
(sensitivitycategory s0 (c0))
(level systemLow (s0))
(levelrange low_low (systemLow systemLow))

(sid kernel)
(sidorder (kernel))
(classorder (file))
(class file (read write open getattr))
(role object_r)

(block autosel_base
    (user user)
    (userrange user (systemLow systemLow))
    (userlevel user systemLow)
    (userrole user role)
    (role role)
    (type process)
    (roletype object_r process)
    (roletype role process)
    (context sid_context (user role process low_low))
    (type object)
    (roletype object_r object)
    (roletype role object)
    (allow process object (file (read)))
)

(sidcontext kernel autosel_base.sid_context)
